---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import products from '../data/products.json';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const SITE = 'https://kanaksan.com';
const {
  title = 'Kanaksan — Simple, free tools for students & developers',
  description = 'Kanaksan is a suite of simple, free web apps: Students’ Companion for Class 11 Physics, a Tamil daily calendar with panchangam, and more tools for students and developers.',
  path = '/',
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE).toString();
const ogImage = `${SITE}/og-image.png`;

const liveApps = products.groups.flatMap((g) => g.items).filter((i) => i.status === 'live' && i.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#org`,
      name: 'Kanaksan',
      url: SITE,
      logo: `${SITE}/favicon.svg`,
      founder: { '@type': 'Person', name: 'Marimuthu Periyannan', url: products.profiles.author },
      sameAs: [products.profiles.github, products.profiles.linkedin, products.profiles.author, ...liveApps.map((a) => a.url)],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: 'Kanaksan',
      url: SITE,
      inLanguage: 'en-IN',
      publisher: { '@id': `${SITE}/#org` },
    },
  ],
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1424" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kanaksan" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kanaksan — Simple, free tools for students & developers" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Set saved theme before first paint: no light/dark flash. -->
    <script is:inline>try{var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline>(function(){var b=document.getElementById('theme-toggle');if(!b)return;b.addEventListener('click',function(){var r=document.documentElement,c=r.dataset.theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'),n=c==='dark'?'light':'dark';r.dataset.theme=n;try{localStorage.setItem('theme',n)}catch(e){}})})()</script>
  </body>
</html>

<style is:global>
  /* ---------- Design tokens (mobile-first) ---------- */
  :root {
    color-scheme: light;
    --bg: #FAF8F3;
    --surface: #FFFFFF;
    --border: #E7E2D6;
    --text: #1C1917;
    --muted: #57534E;
    --primary: #1E3A8A;
    --primary-text: #FFFFFF;
    --accent: #B7791F;
    --live: #15803D;
    --beta: #B45309;
    --soon: #64748B;
    --shadow: 0 10px 30px rgba(28, 25, 23, .12);
    --radius: 14px;
    --header-h: 56px;
    --gutter: 16px;
    --max: 1120px;
    --font: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", "Noto Sans Tamil", "Helvetica Neue", Arial, sans-serif;
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0E1424; --surface: #18203A; --border: #2A3556; --text: #F1F5F9; --muted: #A3AEC2;
    --primary: #93B4FF; --primary-text: #0E1424; --accent: #F2C14E;
    --live: #4ADE80; --beta: #FBBF24; --soon: #94A3B8; --shadow: 0 10px 30px rgba(0, 0, 0, .45);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #0E1424; --surface: #18203A; --border: #2A3556; --text: #F1F5F9; --muted: #A3AEC2;
      --primary: #93B4FF; --primary-text: #0E1424; --accent: #F2C14E;
      --live: #4ADE80; --beta: #FBBF24; --soon: #94A3B8; --shadow: 0 10px 30px rgba(0, 0, 0, .45);
    }
  }
  @media (min-width: 640px) { :root { --gutter: 24px; --header-h: 64px; } }

  /* ---------- Base ---------- */
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  body {
    margin: 0;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.5 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  main { display: flex; flex-direction: column; }
  a { color: var(--primary); text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
  img, svg { display: block; max-width: 100%; }
  .wrap {
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: max(var(--gutter), env(safe-area-inset-left)) max(var(--gutter), env(safe-area-inset-right));
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .skip { position: absolute; left: 8px; top: -60px; z-index: 100; padding: 10px 14px; background: var(--surface); border-radius: 8px; }
  .skip:focus { top: 8px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 48px; padding: 0 20px; border-radius: 999px; border: 0;
    background: var(--primary); color: var(--primary-text);
    font: 600 16px/1 var(--font); text-decoration: none; cursor: pointer;
  }
  .btn:hover { filter: brightness(1.08); }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
