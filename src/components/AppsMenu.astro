---
/**
 * Apps menu: native HTML popover. Works from first paint with zero JavaScript.
 * Mobile: bottom sheet. Desktop (>=1024px): dropdown under the header.
 * All links are in the server HTML, so search engines can crawl them.
 */
import products from '../data/products.json';

// Only released apps are shown: status "live" or "beta" with a URL. Empty groups are hidden.
const groups = products.groups
  .map((g) => ({ ...g, items: g.items.filter((i) => (i.status === 'live' || i.status === 'beta') && i.url) }))
  .filter((g) => g.items.length > 0);
---
<div id="apps-menu" popover class="sheet" aria-label="Kanaksan apps">
  <div class="sheet-head">
    <span class="handle" aria-hidden="true"></span>
    <strong>Kanaksan apps</strong>
    <button class="close" popovertarget="apps-menu" popovertargetaction="hide" aria-label="Close apps menu">✕</button>
  </div>

  {groups.map((g) => (
    <section class="grp" aria-labelledby={`grp-${g.id}`}>
      <h2 id={`grp-${g.id}`}>{g.label}</h2>
      <ul>
        {g.items.map((item) => (
          <li>
            <a class="item" href={item.url}>
              <span class="ico" aria-hidden="true">{item.icon}</span>
              <span class="txt"><span class="name">{item.name}</span><span class="sum">{item.summary}</span></span>
              {item.status === 'beta' ? <span class="tag">Beta</span> : <span class="go" aria-hidden="true">›</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  /* Base = mobile bottom sheet */
  .sheet {
    position: fixed; inset: auto 0 0 0; margin: 0; width: 100%;
    max-height: 82dvh; overflow-y: auto; overscroll-behavior: contain;
    padding: 8px var(--gutter) max(16px, env(safe-area-inset-bottom));
    background: var(--surface); color: var(--text);
    border: 1px solid var(--border); border-bottom: 0; border-radius: 20px 20px 0 0;
    box-shadow: var(--shadow);
  }
  .sheet::backdrop { background: rgba(14, 20, 36, .45); }
  .sheet-head { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 14px 0 6px; }
  .handle { position: absolute; top: 2px; left: 50%; width: 40px; height: 4px; margin-left: -20px; border-radius: 4px; background: var(--border); }
  .close { min-width: 48px; min-height: 48px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-size: 18px; cursor: pointer; }
  .close:hover { background: color-mix(in srgb, var(--text) 7%, transparent); }
  .grp h2 { margin: 14px 0 4px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  ul { list-style: none; margin: 0; padding: 0; }
  .item {
    display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 8px 10px; margin: 0 -10px;
    border-radius: 12px; color: var(--text); text-decoration: none;
  }
  a.item:hover { background: color-mix(in srgb, var(--primary) 9%, transparent); }
  .ico { font-size: 22px; width: 28px; text-align: center; }
  .txt { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .name { font-weight: 600; }
  .sum { font-size: 13px; color: var(--muted); }
  .go { font-size: 22px; line-height: 1; color: var(--muted); }
  .tag { font-size: 12px; font-weight: 600; color: var(--beta); border: 1px solid currentColor; border-radius: 999px; padding: 2px 8px; white-space: nowrap; }
  .grp + .grp { border-top: 1px solid var(--border); margin-top: 8px; }

  /* Desktop = dropdown under header */
  @media (min-width: 1024px) {
    .sheet {
      inset: calc(var(--header-h) + 8px) max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))) auto auto;
      width: 380px; max-height: calc(100dvh - var(--header-h) - 32px);
      border-bottom: 1px solid var(--border); border-radius: var(--radius); padding: 4px 18px 14px;
    }
    .sheet::backdrop { background: transparent; }
    .handle { display: none; }
  }
</style>
