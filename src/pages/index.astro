---
import Base from '../layouts/Base.astro';
import Spotlight from '../components/Spotlight.astro';
import { resolveSpotlight } from '../lib/spotlight';
import { fetchSuiteStats } from '../lib/pulse';
import { pulseAppIds } from '../lib/apps';
import spotlightConfig from '../config/spotlight.json';

// Rendered on the server and cached (ISR, 5 min) — see astro.config.mjs.
export const prerender = false;

// Spotlight: local config for now; Firebase Remote Config next, same resolver.
const spotlight = resolveSpotlight(spotlightConfig);

// Visitor counts for all apps combined, from pulse. null → the footer simply hides them.
const stats = await fetchSuiteStats(pulseAppIds());

// href must match the preload type: with AVIF, use an AVIF candidate (the 960w one if present).
const avifHref = (srcset?: string) => {
  if (!srcset) return undefined;
  const urls = srcset.split(',').map((p) => p.trim().split(/\s+/));
  return (urls.find((u) => u[1] === '960w') ?? urls[0])[0];
};
const preload =
  spotlight.kind === 'content'
    ? {
        href: avifHref(spotlight.srcsetAvif) ?? spotlight.src,
        type: spotlight.srcsetAvif ? 'image/avif' : undefined,
        srcset: spotlight.srcsetAvif ?? spotlight.srcset,
        sizes: spotlight.srcsetAvif || spotlight.srcset ? spotlight.sizes : undefined,
      }
    : null;
---
<Base stats={stats}>
  {preload && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={preload.href}
      type={preload.type}
      imagesrcset={preload.srcset}
      imagesizes={preload.sizes}
      fetchpriority="high"
    />
  )}
  <Spotlight data={spotlight} />
</Base>
